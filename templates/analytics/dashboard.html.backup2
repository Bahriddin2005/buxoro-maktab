{% load static %}
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics Dashboard - Buxoro Bilimdonlar Maktabi</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 25%, #f093fb 50%, #4facfe 75%, #00f2fe 100%);
            min-height: 100vh;
            overflow-x: hidden;
            padding: 0;
            margin: 0;
        }

        /* Glassmorphism Sidebar */
        .sidebar {
            position: fixed;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 20px 15px;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            z-index: 1000;
            width: 70px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .sidebar-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.1);
            color: white;
            font-size: 18px;
            position: relative;
            text-decoration: none;
        }

        .sidebar-icon:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.1);
            color: white;
        }

        .sidebar-icon.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .sidebar-icon.active:hover {
            transform: scale(1.05);
        }

        .sidebar-icon .notification-dot {
            position: absolute;
            top: 5px;
            right: 5px;
            width: 8px;
            height: 8px;
            background: #ff4757;
            border-radius: 50%;
            border: 2px solid white;
        }

        /* Main Container */
        .main-container {
            margin-left: 120px;
            margin-right: 20px;
            padding: 20px;
            min-height: 100vh;
        }

        /* Glass Cards */
        .glass-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 25px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            transition: all 0.3s ease;
            height: 100%;
        }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.5);
        }

        .card-title {
            color: white;
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Toggle Buttons - Rasmga o'xshash */
        .toggle-group {
            display: flex;
            gap: 5px;
            background: rgba(255, 255, 255, 0.08);
            padding: 4px;
            border-radius: 20px;
        }

        .toggle-btn {
            padding: 8px 18px;
            border-radius: 16px;
            border: none;
            background: transparent;
            color: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            font-size: 13px;
            font-weight: 600;
        }

        .toggle-btn:hover:not(.active) {
            color: rgba(255, 255, 255, 0.8);
            background: rgba(255, 255, 255, 0.05);
        }

        .toggle-btn.active {
            background: linear-gradient(135deg, #5a67d8 0%, #6b46c1 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(90, 103, 216, 0.5);
        }

        /* Stats Numbers */
        .stat-number {
            font-size: 42px;
            font-weight: 700;
            color: white;
            margin: 15px 0 10px 0;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        }

        .stat-change {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.8);
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .stat-change.positive {
            color: #2ecc71;
        }

        .stat-change.negative {
            color: #e74c3c;
        }

        /* Progress Bars */
        .progress-item {
            margin-bottom: 20px;
        }

        .progress-label {
            color: white;
            font-size: 14px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .progress-bar-custom {
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            overflow: hidden;
            position: relative;
        }

        .progress-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 1s ease;
            position: relative;
        }

        .progress-fill.purple {
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        }

        .progress-fill.green {
            background: linear-gradient(90deg, #2ecc71 0%, #27ae60 100%);
        }

        /* Circular Progress */
        .circular-progress {
            width: 100px;
            height: 100px;
            position: relative;
            margin: 0 auto;
        }

        .circular-progress svg {
            transform: rotate(-90deg);
        }

        .circular-progress-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-size: 18px;
            font-weight: 700;
        }

        /* Day Selector - Rasmga o'xshash */
        .day-selector {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            gap: 6px;
        }

        .day-btn {
            flex: 1;
            padding: 10px 5px;
            border-radius: 12px;
            border: none;
            background: rgba(255, 255, 255, 0.08);
            color: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            font-size: 12px;
            font-weight: 600;
        }

        .day-btn:hover:not(.active) {
            background: rgba(255, 255, 255, 0.12);
            color: rgba(255, 255, 255, 0.8);
            transform: translateY(-2px);
        }

        .day-btn.active {
            background: linear-gradient(135deg, #5a67d8 0%, #6b46c1 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(90, 103, 216, 0.5);
        }

        /* Chart Container */
        .chart-container {
            position: relative;
            height: 250px;
            margin-top: 20px;
        }

        .chart-container-small {
            position: relative;
            height: 180px;
            margin-top: 15px;
        }

        /* Activity List - Rasmga o'xshash */
        .activity-item {
            background: rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 12px 15px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .activity-item:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateX(8px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .activity-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: white;
            flex-shrink: 0;
        }

        .activity-icon.green {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        }

        .activity-icon.purple {
            background: linear-gradient(135deg, #5a67d8 0%, #6b46c1 100%);
            box-shadow: 0 4px 12px rgba(90, 103, 216, 0.3);
        }

        .activity-icon.blue {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }

        .activity-content {
            flex: 1;
        }

        .activity-title {
            color: white;
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .activity-time {
            color: rgba(255, 255, 255, 0.5);
            font-size: 12px;
            font-weight: 500;
        }

        /* Top Stats - Rasmga o'xshash Menu Items */
        .top-stat-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 10px;
            margin-bottom: 5px;
        }

        .top-stat-item:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateX(5px);
        }

        .top-stat-item:last-child {
            border-bottom: none;
        }

        .top-stat-name {
            color: rgba(255, 255, 255, 0.9);
            font-size: 15px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .top-stat-name i {
            font-size: 20px;
        }

        .top-stat-value {
            color: white;
            font-size: 16px;
            font-weight: 700;
        }

        /* Badge - Rasmga o'xshash */
        .badge-custom {
            min-width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-size: 13px;
            font-weight: 700;
            padding: 0 10px;
        }

        .badge-purple {
            background: linear-gradient(135deg, #5a67d8 0%, #6b46c1 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(90, 103, 216, 0.4);
        }

        .badge-green {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
        }

        .badge-blue {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
        }

        /* Search Bar */
        .search-bar {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            padding: 10px 15px;
            color: white;
            width: 100%;
            margin: 15px 0;
        }

        .search-bar::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        /* Loading */
        .loading {
            text-align: center;
            padding: 40px;
            color: white;
            font-size: 18px;
        }

        .loading i {
            font-size: 40px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Responsive */
        @media (max-width: 768px) {
            .sidebar {
                left: 10px;
                width: 60px;
                padding: 15px 10px;
            }

            .main-container {
                margin-left: 90px;
                margin-right: 10px;
                padding: 10px;
            }

            .glass-card {
                padding: 15px;
            }

            .stat-number {
                font-size: 32px;
            }
        }

        /* Header */
        .dashboard-header {
            margin-bottom: 30px;
        }

        .dashboard-title {
            color: white;
            font-size: 32px;
            font-weight: 700;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
            margin-bottom: 5px;
        }

        .dashboard-subtitle {
            color: rgba(255, 255, 255, 0.8);
            font-size: 16px;
        }

        /* Grid Layout */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        /* Donut Chart */
        .donut-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }

        .donut-number {
            font-size: 36px;
            font-weight: 700;
            color: white;
        }

        .donut-label {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.7);
        }

        /* Clickable Cards */
        .clickable-card {
            transition: all 0.3s ease;
            position: relative;
        }

        .clickable-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 15px 45px 0 rgba(31, 38, 135, 0.6);
        }

        .card-footer-hint {
            text-align: center;
            color: rgba(255, 255, 255, 0.6);
            font-size: 12px;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .clickable-card:hover .card-footer-hint {
            color: rgba(255, 255, 255, 0.9);
        }

        /* Detail Modal - Rasmga o'xshash Dark Blue */
        .detail-modal {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 41, 59, 0.95) 100%);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
        }

        .detail-modal-content {
            position: relative;
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            margin: 3% auto;
            padding: 0;
            border-radius: 24px;
            width: 85%;
            max-width: 1100px;
            max-height: 85vh;
            overflow: hidden;
            border: 1px solid rgba(148, 163, 184, 0.2);
            box-shadow: 
                0 25px 50px -12px rgba(0, 0, 0, 0.8),
                0 0 0 1px rgba(148, 163, 184, 0.1);
            animation: modalFadeIn 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .detail-modal-content > div {
            overflow-y: auto;
            max-height: 85vh;
            padding: 45px;
        }

        @keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: translateY(-80px) scale(0.9);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .modal-close {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: rgba(51, 65, 85, 0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #cbd5e1;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 1px solid rgba(148, 163, 184, 0.2);
        }

        .modal-close:hover {
            background: rgba(71, 85, 105, 1);
            color: white;
            transform: scale(1.05);
        }

        .modal-title {
            color: white;
            font-size: 20px;
            font-weight: 600;
            padding: 22px 30px;
            margin: 0;
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            border-bottom: 1px solid rgba(148, 163, 184, 0.15);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .modal-section {
            margin-bottom: 40px;
            animation: sectionFadeIn 0.5s ease;
        }

        @keyframes sectionFadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-section-title {
            color: white;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
            padding: 14px 20px;
            background: linear-gradient(135deg, #334155 0%, #475569 100%);
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .modal-stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .modal-stat-item {
            background: linear-gradient(135deg, #374151 0%, #4b5563 100%);
            padding: 24px;
            border-radius: 16px;
            text-align: center;
            border: 1px solid rgba(148, 163, 184, 0.15);
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        .modal-stat-item:hover {
            transform: translateY(-5px);
            background: linear-gradient(135deg, #475569 0%, #64748b 100%);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }

        .modal-stat-label {
            color: #cbd5e1;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .modal-stat-value {
            color: white;
            font-size: 36px;
            font-weight: 700;
            margin: 8px 0;
        }

        .modal-stat-change {
            color: #10b981;
            font-size: 14px;
            font-weight: 700;
            margin-top: 6px;
            display: inline-block;
        }

        .modal-table {
            width: 100%;
            margin-top: 20px;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(148, 163, 184, 0.15);
        }

        .modal-table th {
            color: white;
            font-weight: 600;
            font-size: 13px;
            padding: 16px 15px;
            background: linear-gradient(135deg, #475569 0%, #64748b 100%);
            border-bottom: 1px solid rgba(148, 163, 184, 0.2);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .modal-table td {
            color: #e2e8f0;
            padding: 14px 15px;
            border-bottom: 1px solid rgba(148, 163, 184, 0.1);
            background: transparent;
        }

        .modal-table tbody tr {
            background: rgba(51, 65, 85, 0.3);
            transition: all 0.2s ease;
        }

        .modal-table tbody tr:nth-child(even) {
            background: rgba(51, 65, 85, 0.5);
        }

        .modal-table tbody tr:hover {
            background: rgba(71, 85, 105, 0.8);
        }

        .modal-table td strong {
            color: white;
            font-weight: 700;
        }

        /* Custom Scrollbar for Modal - Dark theme */
        .detail-modal-content > div::-webkit-scrollbar {
            width: 8px;
        }

        .detail-modal-content > div::-webkit-scrollbar-track {
            background: rgba(51, 65, 85, 0.5);
        }

        .detail-modal-content > div::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, #64748b 0%, #475569 100%);
            border-radius: 10px;
        }

        .detail-modal-content > div::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(135deg, #475569 0%, #64748b 100%);
        }

        /* Notification Animations */
        @keyframes slideInRight {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @keyframes slideOutRight {
            from {
                transform: translateX(0);
                opacity: 1;
            }
            to {
                transform: translateX(400px);
                opacity: 0;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <!-- User Profile -->
        <a href="{% url 'accounts:profile' %}" class="sidebar-icon" title="Profil">
            <i class="fas fa-user"></i>
        </a>
        
        <!-- Home / Dashboard -->
        <a href="{% url 'accounts:dashboard' %}" class="sidebar-icon" title="Dashboard">
            <i class="fas fa-home"></i>
            {% if user.role == 'admin' %}
                {% if verification_requests_count > 0 %}
                    <span class="notification-dot"></span>
                {% endif %}
            {% endif %}
        </a>
        
        <!-- Analytics (Active) -->
        <a href="{% url 'analytics:dashboard' %}" class="sidebar-icon active" title="Analytics">
            <i class="fas fa-chart-line"></i>
        </a>
        
        <!-- Users Management -->
        {% if user.role == 'admin' %}
            <a href="{% url 'accounts:verification_requests' %}" class="sidebar-icon" title="Foydalanuvchilar">
                <i class="fas fa-users"></i>
            </a>
        {% elif user.role == 'teacher' %}
            <a href="{% url 'tests:tests' %}" class="sidebar-icon" title="Testlar">
                <i class="fas fa-clipboard-list"></i>
            </a>
        {% else %}
            <a href="{% url 'tests:tests' %}" class="sidebar-icon" title="Testlar">
                <i class="fas fa-clipboard-list"></i>
            </a>
        {% endif %}
        
        <!-- Settings / Admin -->
        {% if user.role == 'admin' %}
            <a href="/admin/" class="sidebar-icon" title="Admin Panel">
                <i class="fas fa-cog"></i>
            </a>
        {% else %}
            <a href="{% url 'accounts:profile' %}" class="sidebar-icon" title="Sozlamalar">
                <i class="fas fa-cog"></i>
            </a>
        {% endif %}
    </div>

    <!-- Main Container -->
    <div class="main-container">
        <!-- Header -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">
                <i class="fas fa-chart-line"></i> Analytics Dashboard
            </h1>
            <p class="dashboard-subtitle" id="current-date">1 Jan 2025</p>
        </div>

        <!-- Loading State -->
        <div id="loading" class="loading">
            <i class="fas fa-spinner"></i><br>
            Ma'lumotlar yuklanmoqda...
        </div>

        <!-- Dashboard Content -->
        <div id="dashboard-content" style="display: none;">
            <!-- Row 1: Main Stats -->
            <div class="row mb-4">
                <!-- Logins Chart -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="glass-card clickable-card" onclick="showDetailsModal('logins')" style="cursor: pointer;">
                        <div class="card-title">
                            <span>Analytics</span>
                            <div class="toggle-group">
                                <button class="toggle-btn" data-period="week" onclick="event.stopPropagation()">Week</button>
                                <button class="toggle-btn active" data-period="month" onclick="event.stopPropagation()">Month</button>
                            </div>
                        </div>
                        <div class="chart-container">
                            <canvas id="loginChart"></canvas>
                        </div>
                        <div class="card-footer-hint">
                            <i class="fas fa-info-circle me-1"></i>
                            Batafsil ko'rish uchun bosing
                        </div>
                    </div>
                </div>

                <!-- Progress Bars -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="glass-card clickable-card" onclick="showDetailsModal('tasks')" style="cursor: pointer;">
                        <div class="card-title">
                            <span>Analytics</span>
                            <button class="toggle-btn active" onclick="event.stopPropagation()">All Tasks</button>
                        </div>
                        <div class="progress-item">
                            <div class="progress-label">
                                <span><i class="fas fa-calendar-day"></i> Bugun</span>
                                <span id="today-logins">0</span>
                            </div>
                            <div class="progress-bar-custom">
                                <div class="progress-fill purple" id="progress-today" style="width: 0%;"></div>
                            </div>
                        </div>
                        <div class="progress-item">
                            <div class="progress-label">
                                <span><i class="fas fa-calendar-week"></i> Hafta</span>
                                <span id="week-logins">0</span>
                            </div>
                            <div class="progress-bar-custom">
                                <div class="progress-fill green" id="progress-week" style="width: 0%;"></div>
                            </div>
                        </div>
                        <div class="progress-item">
                            <div class="progress-label">
                                <span><i class="fas fa-calendar-alt"></i> Oy</span>
                                <span id="month-logins">0</span>
                            </div>
                            <div class="progress-bar-custom">
                                <div class="progress-fill purple" id="progress-month" style="width: 0%;"></div>
                            </div>
                        </div>
                        <div class="progress-item">
                            <div class="progress-label">
                                <span><i class="fas fa-calendar"></i> Yil</span>
                                <span id="year-logins">0</span>
                            </div>
                            <div class="progress-bar-custom">
                                <div class="progress-fill purple" id="progress-year" style="width: 0%;"></div>
                            </div>
                        </div>
                        <div class="card-footer-hint">
                            <i class="fas fa-info-circle me-1"></i>
                            Batafsil ko'rish uchun bosing
                        </div>
                    </div>
                </div>

                <!-- Circular Progress & Days -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="glass-card clickable-card" onclick="showDetailsModal('performance')" style="cursor: pointer;">
                        <div class="card-title">
                            <span>Analytics</span>
                            <div class="toggle-group">
                                <button class="toggle-btn active" onclick="event.stopPropagation()">All Profit</button>
                            </div>
                        </div>
                        <div class="row text-center mb-3">
                            <div class="col-4">
                                <div class="circular-progress">
                                    <canvas id="circularProgress1" width="100" height="100"></canvas>
                                    <div class="circular-progress-text" id="circular-text-1">0%</div>
                                </div>
                                <div class="mt-2" style="color: rgba(255,255,255,0.7); font-size: 12px;">Testlar</div>
                            </div>
                            <div class="col-4">
                                <div class="circular-progress">
                                    <canvas id="circularProgress2" width="100" height="100"></canvas>
                                    <div class="circular-progress-text" id="circular-text-2">0%</div>
                                </div>
                                <div class="mt-2" style="color: rgba(255,255,255,0.7); font-size: 12px;">O'quvchilar</div>
                            </div>
                            <div class="col-4">
                                <div class="circular-progress">
                                    <canvas id="circularProgress3" width="100" height="100"></canvas>
                                    <div class="circular-progress-text" id="circular-text-3">0%</div>
                                </div>
                                <div class="mt-2" style="color: rgba(255,255,255,0.7); font-size: 12px;">O'rtacha</div>
                            </div>
                        </div>
                        <div class="day-selector">
                            <button class="day-btn">Mon</button>
                            <button class="day-btn">Tue</button>
                            <button class="day-btn">Wed</button>
                            <button class="day-btn">Thu</button>
                            <button class="day-btn active">Fri</button>
                            <button class="day-btn">Sat</button>
                            <button class="day-btn">Sun</button>
                        </div>
                        <div class="card-footer-hint">
                            <i class="fas fa-info-circle me-1"></i>
                            Batafsil ko'rish uchun bosing
                        </div>
                    </div>
                </div>
            </div>

            <!-- Row 2: Detailed Stats -->
            <div class="row mb-4">
                <!-- Stats Numbers -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="glass-card clickable-card" onclick="showDetailsModal('today')" style="cursor: pointer;">
                        <div class="card-title">
                            <span>Bugungi Statistika</span>
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <div style="color: rgba(255,255,255,0.7); font-size: 14px;">Kirganlar</div>
                                <div class="stat-number" id="stat-logins">0</div>
                                <div class="stat-change positive">
                                    <i class="fas fa-arrow-up"></i> +<span id="login-growth">0</span>%
                                </div>
                            </div>
                            <div class="col-6 mb-3">
                                <div style="color: rgba(255,255,255,0.7); font-size: 14px;">Ro'yxat</div>
                                <div class="stat-number" id="stat-signups">0</div>
                                <div class="stat-change positive">
                                    <i class="fas fa-user-plus"></i> yangi
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="color: rgba(255,255,255,0.7); font-size: 14px;">Testlar</div>
                                <div class="stat-number" id="stat-tests">0</div>
                                <div class="stat-change">
                                    <i class="fas fa-clipboard-list"></i> yangi
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="color: rgba(255,255,255,0.7); font-size: 14px;">Tugallangan</div>
                                <div class="stat-number" id="stat-completed">0</div>
                                <div class="stat-change positive">
                                    <i class="fas fa-check-circle"></i> test
                                </div>
                            </div>
                        </div>
                        <div class="card-footer-hint">
                            <i class="fas fa-info-circle me-1"></i>
                            Batafsil ko'rish uchun bosing
                        </div>
                    </div>
                </div>

                <!-- Half Circle Progress -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="glass-card clickable-card" onclick="showDetailsModal('completion')" style="cursor: pointer;">
                        <div class="card-title">
                            <span>Tugallanish</span>
                            <div class="toggle-group">
                                <button class="toggle-btn" onclick="event.stopPropagation()">Week</button>
                                <button class="toggle-btn active" onclick="event.stopPropagation()">Month</button>
                            </div>
                        </div>
                        <div class="chart-container-small">
                            <canvas id="halfCircleChart"></canvas>
                        </div>
                        <div class="text-center mt-3" style="color: white;">
                            <div style="font-size: 14px; opacity: 0.7;">O'rtacha Ball</div>
                            <div style="font-size: 32px; font-weight: 700;" id="avg-score-display">0%</div>
                        </div>
                        <div class="card-footer-hint">
                            <i class="fas fa-info-circle me-1"></i>
                            Batafsil ko'rish uchun bosing
                        </div>
                    </div>
                </div>

                <!-- Bar Chart -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="glass-card clickable-card" onclick="showDetailsModal('weekly')" style="cursor: pointer;">
                        <div class="card-title">
                            <span>Haftalik Aktivlik</span>
                        </div>
                        <div class="chart-container-small">
                            <canvas id="weeklyBarChart"></canvas>
                        </div>
                        <div class="card-footer-hint">
                            <i class="fas fa-info-circle me-1"></i>
                            Batafsil ko'rish uchun bosing
                        </div>
                    </div>
                </div>
            </div>

            <!-- Row 3: Bottom Stats -->
            <div class="row mb-4">
                <!-- Donut Chart & Stats -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="glass-card">
                        <div class="card-title">
                            <span>Foydalanuvchilar</span>
                        </div>
                        <div class="chart-container-small position-relative">
                            <canvas id="userDonutChart"></canvas>
                            <div class="donut-center">
                                <div class="donut-number" id="total-users">0</div>
                                <div class="donut-label">Jami</div>
                            </div>
                        </div>
                        <div class="mt-4">
                            <div class="top-stat-item" onclick="showUserRoleDetails('students')">
                                <div class="top-stat-name">
                                    <i class="fas fa-graduation-cap" style="color: #3b82f6;"></i>
                                    <span>O'quvchilar</span>
                                </div>
                                <span class="badge-custom badge-purple" id="students-count">0</span>
                            </div>
                            <div class="top-stat-item" onclick="showUserRoleDetails('teachers')">
                                <div class="top-stat-name">
                                    <i class="fas fa-chalkboard-teacher" style="color: #10b981;"></i>
                                    <span>O'qituvchilar</span>
                                </div>
                                <span class="badge-custom badge-green" id="teachers-count">0</span>
                            </div>
                            <div class="top-stat-item" onclick="showUserRoleDetails('admins')">
                                <div class="top-stat-name">
                                    <i class="fas fa-user-shield" style="color: #8b5cf6;"></i>
                                    <span>Adminlar</span>
                                </div>
                                <span class="badge-custom badge-purple" id="admins-count">0</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Activities -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="glass-card">
                        <div class="card-title">
                            <span>Oxirgi Faollik</span>
                            <span style="font-size: 12px; opacity: 0.7;">5 daqiqa</span>
                        </div>
                        <div id="recent-activities">
                            <!-- Activities will be loaded here -->
                        </div>
                    </div>
                </div>

                <!-- Top Tests/Students -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="glass-card">
                        <div class="card-title">
                            <span>Eng Ko'p Ishlangan</span>
                        </div>
                        <div class="chart-container-small">
                            <canvas id="topTestsChart"></canvas>
                        </div>
                        <div class="mt-3" id="top-tests-list">
                            <!-- Top tests will be loaded here -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let analyticsData = null;
        let charts = {};

        // Load Analytics Data
        async function loadAnalytics() {
            try {
                const response = await fetch('/analytics/api/', {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                
                if (!response.ok) throw new Error('Failed to load analytics');
                
                analyticsData = await response.json();
                console.log('Analytics data:', analyticsData);
                
                // Hide loading, show content
                document.getElementById('loading').style.display = 'none';
                document.getElementById('dashboard-content').style.display = 'block';
                
                // Update all components
                updateTodayStats();
                updateProgressBars();
                updateCircularProgress();
                updateStatNumbers();
                updateUserStats();
                updateRecentActivities();
                createCharts();
                
            } catch (error) {
                console.error('Error loading analytics:', error);
                document.getElementById('loading').innerHTML = `
                    <i class="fas fa-exclamation-triangle" style="color: #e74c3c;"></i><br>
                    Xatolik yuz berdi: ${error.message}
                `;
            }
        }

        // Update Today Stats
        function updateTodayStats() {
            const today = analyticsData.today;
            document.getElementById('stat-logins').textContent = today.logins;
            document.getElementById('stat-signups').textContent = today.signups;
            document.getElementById('stat-tests').textContent = today.new_tests;
            document.getElementById('stat-completed').textContent = today.completed;
            
            // Growth
            if (analyticsData.weekly.login_growth) {
                document.getElementById('login-growth').textContent = analyticsData.weekly.login_growth;
            }
        }

        // Update Progress Bars
        function updateProgressBars() {
            const today = analyticsData.today;
            const weekly = analyticsData.weekly;
            const monthly = analyticsData.monthly;
            
            document.getElementById('today-logins').textContent = today.logins;
            document.getElementById('week-logins').textContent = weekly.logins;
            document.getElementById('month-logins').textContent = monthly.logins;
            document.getElementById('year-logins').textContent = monthly.logins * 12; // Approximate
            
            // Animate progress bars
            setTimeout(() => {
                const maxLogins = Math.max(today.logins, weekly.logins, monthly.logins, 100);
                document.getElementById('progress-today').style.width = `${(today.logins / maxLogins) * 100}%`;
                document.getElementById('progress-week').style.width = `${(weekly.logins / maxLogins) * 100}%`;
                document.getElementById('progress-month').style.width = `${(monthly.logins / maxLogins) * 100}%`;
                document.getElementById('progress-year').style.width = `${(monthly.logins * 12 / maxLogins) * 100}%`;
            }, 100);
        }

        // Update Circular Progress
        function updateCircularProgress() {
            const tests = analyticsData.tests;
            
            // Tests completion rate
            drawCircularProgress('circularProgress1', tests.completion_rate, '#667eea', '#764ba2');
            document.getElementById('circular-text-1').textContent = tests.completion_rate + '%';
            
            // Students verification rate
            const users = analyticsData.users;
            drawCircularProgress('circularProgress2', users.verification_rate, '#2ecc71', '#27ae60');
            document.getElementById('circular-text-2').textContent = users.verification_rate + '%';
            
            // Average score
            drawCircularProgress('circularProgress3', tests.avg_score, '#667eea', '#764ba2');
            document.getElementById('circular-text-3').textContent = tests.avg_score + '%';
        }

        // Draw Circular Progress
        function drawCircularProgress(canvasId, percentage, color1, color2) {
            const canvas = document.getElementById(canvasId);
            const ctx = canvas.getContext('2d');
            const centerX = 50;
            const centerY = 50;
            const radius = 40;
            
            // Clear canvas
            ctx.clearRect(0, 0, 100, 100);
            
            // Background circle
            ctx.beginPath();
            ctx.arc(centerX, centerY, radius, 0, 2 * Math.PI);
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
            ctx.lineWidth = 8;
            ctx.stroke();
            
            // Progress arc
            const gradient = ctx.createLinearGradient(0, 0, 100, 100);
            gradient.addColorStop(0, color1);
            gradient.addColorStop(1, color2);
            
            ctx.beginPath();
            ctx.arc(centerX, centerY, radius, -Math.PI / 2, (-Math.PI / 2) + (2 * Math.PI * percentage / 100));
            ctx.strokeStyle = gradient;
            ctx.lineWidth = 8;
            ctx.lineCap = 'round';
            ctx.stroke();
        }

        // Update Stat Numbers
        function updateStatNumbers() {
            const tests = analyticsData.tests;
            document.getElementById('avg-score-display').textContent = tests.avg_score + '%';
        }

        // Update User Stats
        function updateUserStats() {
            const users = analyticsData.users;
            document.getElementById('total-users').textContent = users.total;
            document.getElementById('students-count').textContent = users.students;
            document.getElementById('teachers-count').textContent = users.teachers;
            document.getElementById('admins-count').textContent = users.admins;
        }

        // Update Recent Activities
        function updateRecentActivities() {
            const activities = analyticsData.realtime.activities.slice(0, 5);
            const container = document.getElementById('recent-activities');
            
            if (activities.length === 0) {
                container.innerHTML = '<div style="color: rgba(255,255,255,0.5); text-align: center; padding: 20px;">Hozircha faollik yo\'q</div>';
                return;
            }
            
            container.innerHTML = activities.map(activity => {
                // Icon color based on type - rasmga o'xshash
                let iconClass = 'green';
                let icon = 'fa-arrow-right';
                
                if (activity.type === 'login') {
                    iconClass = 'green';
                    icon = 'fa-arrow-right';
                } else if (activity.type === 'test_start') {
                    iconClass = 'blue';
                    icon = 'fa-play';
                } else if (activity.type === 'test_finish') {
                    iconClass = 'purple';
                    icon = 'fa-check';
                } else {
                    iconClass = 'purple';
                    icon = 'fa-clipboard-check';
                }
                
                return `
                    <div class="activity-item" onclick="showActivityDetails('${activity.user}', '${activity.type}', '${activity.time_ago}')">
                        <div class="activity-icon ${iconClass}">
                            <i class="fas ${icon}"></i>
                        </div>
                        <div class="activity-content">
                            <div class="activity-title">${activity.user}</div>
                            <div class="activity-time">${activity.time_ago}</div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Show Activity Details
        function showActivityDetails(user, type, timeAgo) {
            const modal = document.getElementById('detailModal');
            const modalTitle = document.getElementById('modalTitle');
            const modalContent = document.getElementById('modalDetailContent');
            
            const typeNames = {
                'login': 'Kirdi',
                'logout': 'Chiqdi',
                'test_start': 'Test Boshladi',
                'test_finish': 'Test Tugatdi',
                'signup': 'Ro\'yxatdan O\'tdi'
            };
            
            modalTitle.innerHTML = `🔔 Faollik Tafsiloti`;
            
            modalContent.innerHTML = `
                <div class="modal-section">
                    <h3 class="modal-section-title">📊 Faollik Ma'lumoti</h3>
                    <div class="modal-stat-grid">
                        <div class="modal-stat-item">
                            <div class="modal-stat-label">Foydalanuvchi</div>
                            <div class="modal-stat-value" style="font-size: 28px;">${user}</div>
                        </div>
                        <div class="modal-stat-item">
                            <div class="modal-stat-label">Harakat</div>
                            <div class="modal-stat-value" style="font-size: 24px;">${typeNames[type] || type}</div>
                        </div>
                        <div class="modal-stat-item">
                            <div class="modal-stat-label">Vaqt</div>
                            <div class="modal-stat-value" style="font-size: 20px;">${timeAgo}</div>
                        </div>
                    </div>
                </div>
                
                <div class="modal-section">
                    <h3 class="modal-section-title">📈 Qo'shimcha Ma'lumot</h3>
                    <p style="color: rgba(255,255,255,0.8); text-align: center; padding: 20px;">
                        Foydalanuvchi faolligi uchun batafsil tahlil tez orada qo'shiladi.
                    </p>
                </div>
            `;
            
            modal.style.display = 'block';
        }

        // Create All Charts
        function createCharts() {
            createLoginChart();
            createHalfCircleChart();
            createWeeklyBarChart();
            createUserDonutChart();
            createTopTestsChart();
        }

        // Login Line Chart
        function createLoginChart() {
            const ctx = document.getElementById('loginChart').getContext('2d');
            const activityData = analyticsData.activity_chart;
            
            charts.loginChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: activityData.map(d => d.day),
                    datasets: [{
                        label: 'Kirganlar',
                        data: activityData.map(d => d.logins),
                        borderColor: '#667eea',
                        backgroundColor: 'rgba(102, 126, 234, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 5,
                        pointBackgroundColor: '#667eea',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(255, 255, 255, 0.1)' },
                            ticks: { color: 'rgba(255, 255, 255, 0.7)' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: 'rgba(255, 255, 255, 0.7)' }
                        }
                    }
                }
            });
        }

        // Half Circle Chart
        function createHalfCircleChart() {
            const ctx = document.getElementById('halfCircleChart').getContext('2d');
            const avgScore = analyticsData.tests.avg_score;
            
            charts.halfCircleChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: [avgScore, 100 - avgScore],
                        backgroundColor: ['#667eea', 'rgba(255, 255, 255, 0.1)'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    circumference: 180,
                    rotation: 270,
                    cutout: '75%',
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: false }
                    }
                }
            });
        }

        // Weekly Bar Chart
        function createWeeklyBarChart() {
            const ctx = document.getElementById('weeklyBarChart').getContext('2d');
            const activityData = analyticsData.activity_chart;
            
            charts.weeklyBarChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: activityData.map(d => d.day),
                    datasets: [{
                        data: activityData.map(d => d.completed),
                        backgroundColor: activityData.map((_, i) => i % 2 === 0 ? '#667eea' : '#2ecc71'),
                        borderRadius: 10,
                        barThickness: 20
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(255, 255, 255, 0.1)' },
                            ticks: { color: 'rgba(255, 255, 255, 0.7)' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: 'rgba(255, 255, 255, 0.7)' }
                        }
                    }
                }
            });
        }

        // User Donut Chart
        function createUserDonutChart() {
            const ctx = document.getElementById('userDonutChart').getContext('2d');
            const users = analyticsData.users;
            
            charts.userDonutChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['O\'quvchilar', 'O\'qituvchilar', 'Adminlar'],
                    datasets: [{
                        data: [users.students, users.teachers, users.admins],
                        backgroundColor: ['#667eea', '#2ecc71', '#764ba2'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        // Top Tests Chart
        function createTopTestsChart() {
            const ctx = document.getElementById('topTestsChart').getContext('2d');
            const topTests = analyticsData.top_tests.slice(0, 5);
            
            charts.topTestsChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: topTests.map(t => t.title.substring(0, 20)),
                    datasets: [{
                        label: 'Urinishlar',
                        data: topTests.map(t => t.attempts),
                        backgroundColor: '#667eea',
                        borderRadius: 8,
                        barThickness: 15
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            grid: { color: 'rgba(255, 255, 255, 0.1)' },
                            ticks: { color: 'rgba(255, 255, 255, 0.7)' }
                        },
                        y: {
                            grid: { display: false },
                            ticks: { color: 'rgba(255, 255, 255, 0.7)', font: { size: 10 } }
                        }
                    }
                }
            });
        }

        // Set Current Date
        function setCurrentDate() {
            const now = new Date();
            const options = { year: 'numeric', month: 'short', day: 'numeric' };
            document.getElementById('current-date').textContent = now.toLocaleDateString('uz-UZ', options);
        }

        // Day selector functionality - To'liq ishlashi
        let selectedDay = 'Fri'; // Default (rasmda Fri active)
        document.querySelectorAll('.day-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                const day = this.textContent.trim();
                selectedDay = day;
                
                // Update active state
                document.querySelectorAll('.day-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                
                // Update performance data by day
                updatePerformanceByDay(day);
                
                // Notification
                showNotification(`${day} kuni ma'lumotlari ko'rsatilmoqda`, 'info');
            });
        });

        // Toggle buttons functionality - Period filter
        let currentPeriod = 'month'; // Default
        document.querySelectorAll('.toggle-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                const parent = this.parentElement;
                const period = this.getAttribute('data-period') || this.textContent.toLowerCase();
                
                // Update active state in this group only
                parent.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                
                // Update data based on period
                if (period === 'week' || period === 'month') {
                    currentPeriod = period;
                    updateChartsByPeriod(period);
                    showNotification(`${period === 'week' ? 'Haftalik' : 'Oylik'} ma'lumotlar ko'rsatilmoqda`, 'info');
                }
            });
        });

        // Update performance by selected day
        function updatePerformanceByDay(day) {
            if (!analyticsData) return;
            
            // Find day data from chart
            const dayData = analyticsData.activity_chart.find(d => d.day === day);
            
            if (dayData) {
                // Update circular progress based on day's data
                const testsPercent = dayData.completed > 0 ? Math.min((dayData.completed / 5) * 100, 100) : 0;
                const studentsPercent = dayData.logins > 0 ? Math.min((dayData.logins / 10) * 100, 100) : 0;
                const avgPercent = dayData.completed > 0 ? Math.min((dayData.completed / 3) * 100, 100) : 0;
                
                // Update circular progress
                drawCircularProgress('circularProgress1', testsPercent, '#667eea', '#764ba2');
                document.getElementById('circular-text-1').textContent = Math.round(testsPercent) + '%';
                
                drawCircularProgress('circularProgress2', studentsPercent, '#2ecc71', '#27ae60');
                document.getElementById('circular-text-2').textContent = Math.round(studentsPercent) + '%';
                
                drawCircularProgress('circularProgress3', avgPercent, '#667eea', '#764ba2');
                document.getElementById('circular-text-3').textContent = Math.round(avgPercent) + '%';
            }
        }

        // Update charts by period
        function updateChartsByPeriod(period) {
            if (!analyticsData) return;
            
            // This would update the charts based on selected period
            // For now, just show notification
            console.log(`Charts updated for ${period}`);
            
            // Re-create charts with filtered data if needed
            if (period === 'week') {
                // Show last 7 days
                console.log('Showing weekly data');
            } else {
                // Show last 30 days
                console.log('Showing monthly data');
            }
        }

        // Notification system
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: ${type === 'info' ? 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)' : 'linear-gradient(135deg, #2ecc71 0%, #27ae60 100%)'};
                color: white;
                padding: 15px 25px;
                border-radius: 15px;
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
                z-index: 10000;
                font-weight: 600;
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.3);
                animation: slideInRight 0.3s ease;
            `;
            notification.textContent = message;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.style.animation = 'slideOutRight 0.3s ease';
                setTimeout(() => notification.remove(), 300);
            }, 2000);
        }

        // Initialize
        setCurrentDate();
        loadAnalytics();
        
        // Auto refresh every 30 seconds
        setInterval(loadAnalytics, 30000);

        // Detail Modal Functions
        function showDetailsModal(cardType) {
            const modal = document.getElementById('detailModal');
            const modalTitle = document.getElementById('modalTitle');
            const modalContent = document.getElementById('modalDetailContent');
            
            // Set title and content based on card type
            let title = '';
            let content = '';
            
            switch(cardType) {
                case 'logins':
                    title = '📊 Kirish Statistikasi - Batafsil Ma\'lumot';
                    content = generateLoginsDetail();
                    break;
                case 'tasks':
                    title = '📋 Vazifalar va Faollik - Batafsil Ma\'lumot';
                    content = generateTasksDetail();
                    break;
                case 'performance':
                    title = '📈 Samaradorlik Ko\'rsatkichlari - Batafsil Ma\'lumot';
                    content = generatePerformanceDetail();
                    break;
                case 'today':
                    title = '📅 Bugungi Statistika - Batafsil Ma\'lumot';
                    content = generateTodayDetail();
                    break;
                case 'completion':
                    title = '✅ Tugallanish Foizi - Batafsil Ma\'lumot';
                    content = generateCompletionDetail();
                    break;
                case 'weekly':
                    title = '📊 Haftalik Aktivlik - Batafsil Ma\'lumot';
                    content = generateWeeklyDetail();
                    break;
                default:
                    title = 'Ma\'lumot';
                    content = '<p>Ma\'lumot topilmadi</p>';
            }
            
            modalTitle.innerHTML = title;
            modalContent.innerHTML = content;
            modal.style.display = 'block';
        }

        function closeModal() {
            document.getElementById('detailModal').style.display = 'none';
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById('detailModal');
            if (event.target == modal) {
                modal.style.display = 'none';
            }
        }

