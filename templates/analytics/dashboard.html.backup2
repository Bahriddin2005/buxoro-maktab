                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <div style="flex: 1; height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px;">
                                                    <div style="width: ${activityPercent}%; height: 100%; background: #10b981; border-radius: 4px;"></div>
                                                </div>
                                                <span>${activityPercent}%</span>
                                            </div>
                                        </td>
                                    </tr>
                                `;
                            }).join('')}
                        </tbody>
                    </table>
                </div>
            `;
        }

        // Show User Role Details - Yangi funksiya
        async function showUserRoleDetails(role) {
            const modal = document.getElementById('detailModal');
            const modalTitle = document.getElementById('modalTitle');
            const modalContent = document.getElementById('modalDetailContent');
            
            const roleNames = {
                'students': 'O\'quvchilar',
                'teachers': 'O\'qituvchilar',
                'admins': 'Adminlar'
            };
            
            const roleIcons = {
                'students': '👨‍🎓',
                'teachers': '👨‍🏫',
                'admins': '👨‍💼'
            };
            
            modalTitle.innerHTML = `${roleIcons[role]} ${roleNames[role]} - Batafsil Ma'lumot`;
            
            // Show loading
            modalContent.innerHTML = '<div class="text-center py-5"><i class="fas fa-spinner fa-spin fa-3x"></i><br><br>Yuklanmoqda...</div>';
            modal.style.display = 'block';
            
            try {
                // Fetch detailed user data by role
                const response = await fetch(`/analytics/api/?role=${role}`);
                const data = await response.json();
                
                modalContent.innerHTML = generateUserRoleDetail(role, data);
            } catch (error) {
                modalContent.innerHTML = `
                    <div class="modal-section">
                        <h3 class="modal-section-title">${roleIcons[role]} ${roleNames[role]} Statistikasi</h3>
                        <div class="modal-stat-grid">
                            <div class="modal-stat-item">
                                <div class="modal-stat-label">Jami ${roleNames[role]}</div>
                                <div class="modal-stat-value">${analyticsData.users[role]}</div>
                                <div class="modal-stat-change">Foydalanuvchi</div>
                            </div>
                            <div class="modal-stat-item">
                                <div class="modal-stat-label">Tasdiqlangan</div>
                                <div class="modal-stat-value">${analyticsData.users.verified}</div>
                                <div class="modal-stat-change">Verified</div>
                            </div>
                            <div class="modal-stat-item">
                                <div class="modal-stat-label">Faol (24h)</div>
                                <div class="modal-stat-value">${analyticsData.users.active_24h}</div>
                                <div class="modal-stat-change">Kishi</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="modal-section">
                        <h3 class="modal-section-title">📊 Umumiy Ma'lumot</h3>
                        <p style="color: rgba(255,255,255,0.8); text-align: center; padding: 20px;">
                            ${roleNames[role]} uchun batafsil statistika tez orada qo'shiladi.
                        </p>
                    </div>
                `;
            }
        }

        function generateUserRoleDetail(role, data) {
            const roleNames = {
                'students': 'O\'quvchilar',
                'teachers': 'O\'qituvchilar',
                'admins': 'Adminlar'
            };
            
            return `
                <div class="modal-section">
                    <h3 class="modal-section-title">📊 ${roleNames[role]} Statistikasi</h3>
                    <div class="modal-stat-grid">
                        <div class="modal-stat-item">
                            <div class="modal-stat-label">Jami ${roleNames[role]}</div>
                            <div class="modal-stat-value">${analyticsData.users[role]}</div>
                            <div class="modal-stat-change">Foydalanuvchi</div>
                        </div>
                        <div class="modal-stat-item">
                            <div class="modal-stat-label">Tasdiqlangan</div>
                            <div class="modal-stat-value">${analyticsData.users.verified}</div>
                            <div class="modal-stat-change">Verified</div>
                        </div>
                        <div class="modal-stat-item">
                            <div class="modal-stat-label">Faol (24h)</div>
                            <div class="modal-stat-value">${analyticsData.users.active_24h}</div>
                            <div class="modal-stat-change">Kishi</div>
                        </div>
                        ${role === 'students' ? `
                            <div class="modal-stat-item">
                                <div class="modal-stat-label">O'rtacha Ball</div>
                                <div class="modal-stat-value" style="color: #10b981;">${analyticsData.tests.avg_score}%</div>
                                <div class="modal-stat-change">Barcha testlardan</div>
                            </div>
                        ` : ''}
                    </div>
                </div>
                
                <div class="modal-section">
                    <h3 class="modal-section-title">📈 To'liq Statistika</h3>
                    <p style="color: rgba(255,255,255,0.8); text-align: center; padding: 20px;">
                        ${roleNames[role]} ro'yxati va batafsil ma'lumotlar tez orada qo'shiladi.
                    </p>
                </div>
            `;
        }
    </script>

    <!-- Detail Modal - Rasmga o'xshash struktura -->
    <div id="detailModal" class="detail-modal">
        <div class="detail-modal-content">
            <h2 class="modal-title" id="modalTitle">
                Batafsil Ma'lumot
                <span class="modal-close" onclick="closeModal()">&times;</span>
            </h2>
            <div>
                <div id="modalDetailContent">
                    <!-- Content will be loaded here -->
                </div>
            </div>
        </div>
    </div>
</body>
</html>

