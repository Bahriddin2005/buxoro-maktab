                            </tr>
                        </thead>
                        <tbody>
                            ${chart.map(day => {
                                const activityPercent = weekly.logins > 0 ? ((day.logins / weekly.logins) * 100).toFixed(1) : 0;
                                return `
                                    <tr>
                                        <td><strong>${day.day}</strong></td>
                                        <td>${day.date}</td>
                                        <td>${day.logins}</td>
